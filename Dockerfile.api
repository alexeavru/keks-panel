# docker build -f Dockerfile.api -t keks-panel-api .
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    KEKS_API_PORT=8787
RUN apk add --no-cache tini
COPY package.json ./
RUN node <<'NODE'
const fs = require('node:fs')
const p = JSON.parse(fs.readFileSync('package.json', 'utf8'))
const names = ['@kubernetes/client-node', 'cors', 'express', 'js-yaml', 'ws']
const dependencies = {}
for (const name of names) {
  if (!p.dependencies[name]) throw new Error(`missing dependency ${name}`)
  dependencies[name] = p.dependencies[name]
}
dependencies.tsx = p.devDependencies.tsx
fs.writeFileSync('package.json', JSON.stringify({ name: p.name, version: p.version, type: 'module', dependencies }, null, 2))
NODE
RUN npm install --omit=dev
COPY server ./server
EXPOSE 8787
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["./node_modules/.bin/tsx", "server/index.ts"]
